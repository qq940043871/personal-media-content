# ============================================================
# AI 自媒体内容生产中台 — 全局配置模板
# 使用方法：复制为 .env 后填入实际值
# ============================================================

# ===== 模型 Provider 注册表（全仓凭据唯一存放处）=====
# 每个 provider 一组：PROVIDER_<ID>_API_KEY / _BASE_URL，模型按能力加后缀
#   _CHAT_MODEL（对话）/ _ASR_MODEL（转写）/ _IMAGE_MODEL（生图）
#   图像端点与对话不同时，用 _IMAGE_URL 覆盖 _BASE_URL
# 各能力用 LLM_PROVIDER / ASR_PROVIDER / IMAGE_PROVIDER 指向某个 <ID>
# 换模型只改本段，业务线（core / hello_feishu / hello_webchat_solo）自动跟随

PROVIDER_MIMO_API_KEY=your_mimo_api_key
PROVIDER_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
PROVIDER_MIMO_CHAT_MODEL=mimo-v2.6-pro
PROVIDER_MIMO_ASR_MODEL=mimo-v2.5-asr

PROVIDER_ARK_API_KEY=your_ark_api_key
PROVIDER_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PROVIDER_ARK_CHAT_MODEL=doubao-seed-2-0-pro-260215
PROVIDER_ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
PROVIDER_ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

LLM_PROVIDER=mimo
ASR_PROVIDER=mimo
IMAGE_PROVIDER=ark

# ===== 旧键回退（可选：注册表缺对应能力时才生效）=====
# LLM_API_KEY / LLM_API_URL / LLM_MODEL
# ASR_API_KEY / ASR_API_URL / ASR_MODEL

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
ASR_LANGUAGE=zh

# ===== 本地 ASR（faster-whisper，可选）=====
ASR_LOCAL_ENABLED=false
ASR_LOCAL_MODEL_SIZE=base
ASR_LOCAL_MODEL_PATH=
ASR_LOCAL_DEVICE=auto
ASR_LOCAL_COMPUTE_TYPE=auto
ASR_LOCAL_BEAM_SIZE=5
ASR_LOCAL_DOWNLOAD_ROOT=models/asr

# ===== 视频处理（FFmpeg）=====
FFMPEG_PATH=ffmpeg
FRAME_INTERVAL=10
OUTPUT_QUALITY=2

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# lark-cli 的 run.js 路径（Windows 默认安装位置，可按需修改）
LARK_CLI_RUN_JS=C:\Program Files\nodejs\node_modules\@larksuite\cli\scripts\run.js

# ===== 微信公众号 =====
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_DEFAULT_AUTHOR=
WECHAT_OPEN_COMMENT=0

# ===== 存储路径 =====
STORAGE_BASE=storage
STORAGE_VIDEO_INPUT=storage/videos_input
STORAGE_VIDEO_OUTPUT=storage/videos_output
STORAGE_ARTICLES=storage/articles
STORAGE_NOVELS=storage/novels
